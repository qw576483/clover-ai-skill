#!/bin/sh
# pre-commit gate for the skill package (source of truth; install with scripts/install-hooks.ps1)
#
# "An instruction is a request, a gate is a guarantee."
# Until this hook exists, every self-check in this repo depends on somebody REMEMBERING to run
# it. Three defects shipped and no gate fired -- a dangling section
# pointer, a self-contradicting constant, and a false-red rule. Two of the three are now
# mechanical; this hook is what makes them run without being asked.
#
# A FAIL blocks the commit. That is the whole point: a check you can skip is a check you will skip.

set -u

repo=$(git rev-parse --show-toplevel)
fails=""

run_check() {
    name="$1"; script="$2"
    printf '[skill-gate] %s ...\n' "$name"
    if ! powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$repo/$script"; then
        fails="$fails $name"
    fi
}

run_check "skill-health" "scripts/skill-health.ps1"
run_check "skill-lint"   "scripts/skill-lint.ps1"

if [ -n "$fails" ]; then
    printf '\n[skill-gate] BLOCKED:%s reported FAIL.\n' "$fails"
    printf '[skill-gate] Fix it, or the commit does not happen. Run the script above for details.\n'
    exit 1
fi

printf '[skill-gate] OK -- all checks passed\n'
exit 0
